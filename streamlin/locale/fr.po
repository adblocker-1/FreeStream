msgstr "Élimine le ronflement grave et les bruits de pas"

#: streamlin/waveui.py:576
msgid "Monitoring"
msgstr "Retour micro"

#: streamlin/waveui.py:576
msgid "Balance of mic ↔ PC audio in your headphones"
msgstr "Équilibre micro ↔ son du PC dans votre casque"

#: streamlin/waveui.py:589
